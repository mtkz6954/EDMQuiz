/* GameScene presentation — portrait 720×1280 layout */

.stage-light-wash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* 暗紫の追加 wash。background-panel と組み合わせて画面を暗化し、
       Light2D スポットライトのコントラストを稼ぐ。 */
    background-color: rgba(15, 2, 38, 0.12);
}

.progress-counter {
    position: absolute;
    top: 28px;
    left: 24px;
    width: 130px;
    height: 50px;
    padding: 3px 12px;
    background-color: rgba(20, 8, 44, 0.9);
    border-radius: 25px;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
}

.question-panel {
    position: absolute;
    top: 62px;
    left: 3%;
    right: 3%;
    /* 従来 UXML インラインで 151px 指定だったものを USS へ移動
       （縦画面では .layout-portrait で拡大する） */
    height: 151px;
    flex-direction: row;
    align-items: center;
    padding: 14px 36px;
    overflow: hidden;
    background-image: url("../../Sprites/UI/Generated/question_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.question-number-badge {
    width: 92px;
    height: 92px;
    min-width: 92px;
    margin-right: 14px;
    background-image: url("../../Sprites/UI/Generated/question_number_badge.png");
    -unity-background-scale-mode: scale-to-fit;
    color: rgb(16, 5, 38);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.question-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    overflow: hidden;
    color: rgb(16, 5, 38);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 0;
}

.instruction-label {
    position: absolute;
    /* 従来 UXML インラインで 198px 指定だったものを USS へ移動 */
    top: 198px;
    left: 24px;
    width: 260px;
    height: 64px;
    padding: 6px 16px;
    background-color: rgb(202, 248, 60);
    border-radius: 4px;
    border-width: 4px;
    border-color: rgb(20, 8, 44);
    color: rgb(20, 8, 44);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    rotate: -6deg;
}

.answer-cells {
    position: absolute;
    top: 290px;
    left: 0;
    right: 0;
    height: 100px;
    flex-direction: row;
    justify-content: center;
}

.answer-cell {
    width: 90px;
    height: 90px;
    margin: 5px 10px;
    background-image: url("../../Sprites/UI/Generated/answer_slot_frame_neon.png");
    -unity-background-scale-mode: scale-to-fit;
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.answer-cell--c0 { -unity-background-image-tint-color: rgb(240, 64, 255); }
.answer-cell--c1 { -unity-background-image-tint-color: rgb(44, 220, 255); }
.answer-cell--c2 { -unity-background-image-tint-color: rgb(190, 255, 0); }
.answer-cell--c3 { -unity-background-image-tint-color: rgb(255, 70, 190); }

.answer-cell--filled {
    color: rgb(255, 255, 255);
}

.answer-cell--cursor {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.hiragana-buttons {
    position: absolute;
    top: 400px;
    left: 4%;
    width: 92%;
    height: 200px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.hiragana-key-row {
    height: 64px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.hiragana-key-row--wide {
    display: none;
    height: 64px;
}

.hiragana-button {
    width: 130px;
    height: 56px;
    margin: 3px 8px;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: scale, opacity;
    transition-duration: 0.08s;
}

.hiragana-button:hover { scale: 1.05 1.05; }
.hiragana-button:active { scale: 0.94 0.94; }

.hiragana-button:disabled { opacity: 0.35; }
.hiragana-button.is-used   { opacity: 0.30; }

.hiragana-button--c0,
.hiragana-button--c5 { background-image: url("../../Sprites/UI/Generated/key_button_purple.png"); }
.hiragana-button--c1,
.hiragana-button--c6 { background-image: url("../../Sprites/UI/Generated/key_button_blue.png"); }
.hiragana-button--c2,
.hiragana-button--c7 { background-image: url("../../Sprites/UI/Generated/key_button_red.png"); }
.hiragana-button--c3 { background-image: url("../../Sprites/UI/Generated/key_button_blue.png"); }
.hiragana-button--c4 { background-image: url("../../Sprites/UI/Generated/key_button_green.png"); }
.hiragana-button--c8 { background-image: url("../../Sprites/UI/Generated/key_button_orange.png"); }
.hiragana-button--c9 { background-image: url("../../Sprites/UI/Generated/key_button_wide_purple.png"); }

.hiragana-button--wide {
    width: 360px;
    height: 58px;
    background-image: url("../../Sprites/UI/Generated/key_button_wide_purple.png");
}

.hiragana-number-badge {
    position: absolute;
    top: 8px;
    left: 12px;
    width: 30px;
    height: 30px;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(12, 4, 36, 0.58);
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    border-radius: 3px;
    rotate: 45deg;
    -unity-text-align: middle-center;
    padding: 0;
}

.countdown-widget {
    position: absolute;
    top: 228px;
    right: 4%;
    width: 170px;
    height: 170px;
    align-items: center;
    justify-content: center;
}

.countdown-ring-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../../Sprites/UI/Generated/countdown_ring_frame.png");
    -unity-background-scale-mode: scale-to-fit;
}

.buildup-countdown {
    width: 115px;
    height: 115px;
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ビート進捗ドット — countdown-widget 内下部に表示 */
.buildup-dots {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    height: 14px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.beat-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.22);
    margin: 0 2px;
}

.beat-dot--filled {
    background-color: rgb(202, 248, 60);
}

.answer-now-callout {
    position: absolute;
    top: 400px;
    right: 4%;
    width: 220px;
    height: 80px;
    padding: 14px 12px 6px 12px;
    background-image: url("../../Sprites/UI/Generated/answer_now_burst_frame.png");
    -unity-background-scale-mode: scale-to-fit;
    color: rgb(16, 5, 38);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 消す（backspace）ボタン — AnswerWindow 中に有効、それ以外は無効表示 */
.control-buttons {
    position: absolute;
    top: 410px;
    left: 24px;
    display: flex;
    flex-direction: column;
}

.control-button {
    padding: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 3px;
    transition-property: scale, opacity;
    transition-duration: 0.08s;
}

.backspace-button {
    width: 110px;
    height: 70px;
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgba(40, 10, 80, 0.88);
    border-radius: 14px;
    border-color: rgb(160, 80, 255);
}

.backspace-button:hover  { scale: 1.05 1.05; }
.backspace-button:active { scale: 0.94 0.94; }
.backspace-button:disabled { opacity: 0.35; }

.confirm-button { display: none; }

.characters-strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -18px;
    height: 158px;
    padding: 0;
}

.character-slot {
    position: absolute;
    bottom: 0;
    height: 100%;
    width: 112px;
    background-size: contain;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
}

.character-slot--v0 { left: 4%; rotate: -4deg; width: 142px; }
.character-slot--v1 { left: 22%; rotate: 5deg; width: 74px; opacity: 0.82; }
.character-slot--v2 { right: 24%; rotate: -1deg; width: 74px; opacity: 0.82; }
.character-slot--v3 { right: 17%; rotate: 4deg; width: 76px; opacity: 0.82; }
.character-slot--v4 { right: 4%; rotate: -3deg; width: 142px; }

.cameo-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.cameo-slot {
    position: absolute;
    width: 58px;
    height: 66px;
    background-size: contain;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.75;
}

/* 左右の端に散らして配置 — ボタン・回答セル・メインキャラと重ならない縦帯に収める */
.cameo-slot--v0 { left: 320;   bottom: 158px;  rotate: -7deg; }
.cameo-slot--v1 { left: 35;   bottom: 168px; rotate:  3deg; }
.cameo-slot--v2 { left: 220;   bottom: 270px; rotate: -2deg; }
.cameo-slot--v3 { right: 10;  bottom: 140px;  rotate:  6deg; }
.cameo-slot--v4 { right: 330;  bottom: 300px; rotate: -5deg; }

.blue-overlay,
.flash-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.blue-overlay   { background-color: rgba(0, 80, 255, 0); }
.flash-overlay  { background-color: rgba(255, 255, 220, 0); }
.fade-overlay   { background-color: rgb(0, 0, 0); opacity: 0; }

.correct-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 34%;
    width: 100%;
    height: 150px;
    -unity-text-align: middle-center;
    font-size: 88px;
    color: rgb(255, 230, 0);
    -unity-font-style: bold;
    scale: 0 0;
}

.incorrect-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    width: 100%;
    height: 130px;
    -unity-text-align: middle-center;
    font-size: 76px;
    color: rgb(180, 220, 255);
    -unity-font-style: bold;
    scale: 0 0;
}

.result-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 26, 0.95);
}

.result-title {
    font-size: 28px;
    color: rgb(170, 170, 204);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.score-label {
    font-size: 80px;
    color: rgb(255, 230, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.score-unit {
    font-size: 32px;
    color: rgb(255, 230, 0);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.rank-label {
    font-size: 100px;
    color: rgb(255, 60, 142);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    scale: 0 0;
}

.rank-text-label {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 32px;
}

.retry-button {
    min-width: 240px;
    height: 72px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(13, 13, 26);
    background-color: rgb(0, 240, 255);
    border-color: rgb(0, 240, 255);
    border-radius: 20px;
    border-width: 0;
}

/* ================================================================
   Landscape overrides — PC 横長表示（フルスクリーン or 横長 iframe）
   ResponsiveLayout.cs により root に .layout-landscape が付与される。
   - 参照解像度 720x1280 + m_Match: 1 (高さ基準) のため、
     ref space の width はビューポート幅 / scale で広がる（例: 1280x720 → ref 2275x1280）
   - そのため left:50% は実画面中央に対応するので、margin-left + width 固定で中央寄せできる
================================================================ */

.layout-landscape .question-panel {
    /* 横長で全幅に伸びるのを防ぎ、画面中央に固定幅で配置 */
    left: 50%;
    right: auto;
    width: 720px;
    margin-left: -360px;
}

.layout-landscape .hiragana-buttons {
    /* ボタン群も中央 720px に集約 */
    left: 50%;
    right: auto;
    width: 720px;
    margin-left: -360px;
}

.layout-landscape .answer-cells {
    /* answer-cells は左右 0 で flex 中央寄せ済み → ref space 中央へ追従するので OK */
    left: 0;
    right: 0;
}

.layout-landscape .countdown-widget {
    /* 右端 4% (= ref 2185 ≒ 実 1230px) は遠すぎるので中央パネルの右隣へ */
    right: auto;
    left: 50%;
    margin-left: 380px;
}

.layout-landscape .answer-now-callout {
    /* countdown-widget と同様、中央パネルの右隣へ */
    right: auto;
    left: 50%;
    margin-left: 380px;
}

.layout-landscape .progress-counter {
    /* 左端 24px (= 実 13.5px) のままだと遠すぎるので中央パネル左肩へ */
    left: 50%;
    margin-left: -360px;
}

.layout-landscape .instruction-label {
    /* 中央パネルの左隣にずらす */
    left: 50%;
    margin-left: -340px;
}

.layout-landscape .control-buttons {
    /* backspace 等のコントロール群も中央パネル左下へ */
    left: 50%;
    margin-left: -360px;
}

.layout-landscape .characters-strip {
    /* 横長では左右に余裕があるので、デフォルト % 配置でキャラが横に広がる。
       追加調整は不要だが、底辺を少し上げて見切れを防ぐ */
    bottom: 0;
}

/* ================================================================
   Portrait overrides — 縦画面（スマホ実機・PC の縦キャンバス共通。
   ResponsiveLayout が root に .layout-portrait を付与）
   方針:
   - 入力ボタン群を親指の届く画面下部へ寄せ、タップしやすいサイズへ拡大
   - 回答セルはボタン群の直上に配置して視線移動を最小化
   - 縦画面では match=0（幅基準）のため ref 幅は常に 720px。
     縦長端末では ref 高さが 1280 以上に伸びる → bottom 基準で配置する
   - PC 横画面（.layout-landscape）には一切影響しない
================================================================ */

.layout-portrait .question-panel {
    /* 縦画面は 1 行の文字数が少なく行数が増えるため、長文が収まる高さへ拡大 */
    height: 240px;
}

.layout-portrait .instruction-label {
    /* 拡大した問題パネルの下端に追従（パネル下端 302px の少し上に重ねる） */
    top: 288px;
}

.layout-portrait .countdown-widget {
    /* 拡大した問題パネルと被らない位置へ */
    top: 320px;
}

.layout-portrait .hiragana-buttons {
    /* 拡大ボタン 3 行分の高さを確保（92px × 3 + 余白）
       下部アンカーに切替（キャラ帯のすぐ上） */
    height: 300px;
    top: auto;
    bottom: 180px;
}

.layout-portrait .hiragana-key-row {
    height: 92px;
}

.layout-portrait .hiragana-button {
    width: 190px;
    height: 84px;
    margin: 4px 8px;
    font-size: 52px;
}

.layout-portrait .hiragana-button--wide {
    width: 480px;
    height: 84px;
}

.layout-portrait .answer-cell {
    width: 100px;
    height: 100px;
    font-size: 56px;
}

.layout-portrait .answer-cells {
    /* ボタン群の直上へ（bottom: 180 + 300 + 30） */
    top: auto;
    bottom: 510px;
    height: 110px;
}

.layout-portrait .answer-now-callout {
    /* 「答えて！」は回答セルの右上あたりに寄せる */
    top: auto;
    bottom: 640px;
    right: 4%;
}

.layout-portrait .retry-button {
    min-width: 320px;
    height: 96px;
    font-size: 36px;
}

/* 縦画面のカメオ再配置 — 下部アンカーの入力クラスタ
   （ボタン: bottom 180-480 / セル: bottom 510-620 / 答えて!: bottom 640-720 x471-691 /
     カウントダウン: 9:16 時 bottom 790-960 x551-693）を避けた空きゾーンへ散らす */
.layout-portrait .cameo-slot--v0 { left: 320px; bottom: 660px; }
.layout-portrait .cameo-slot--v1 { left: 35px;  bottom: 650px; }
.layout-portrait .cameo-slot--v2 { left: 150px; bottom: 780px; }
.layout-portrait .cameo-slot--v3 { right: 10px; bottom: 740px; }
.layout-portrait .cameo-slot--v4 { right: auto; left: 380px; bottom: 850px; }

