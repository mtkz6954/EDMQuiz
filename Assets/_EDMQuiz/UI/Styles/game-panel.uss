/* GameScene presentation — portrait 720×1280 layout */

.stage-light-wash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* 暗紫の追加 wash。background-panel と組み合わせて画面を暗化し、
       Light2D スポットライトのコントラストを稼ぐ。 */
    background-color: rgba(15, 2, 38, 0.12);
}

.progress-counter {
    position: absolute;
    top: 28px;
    left: 24px;
    width: 130px;
    height: 50px;
    padding: 3px 12px;
    background-color: rgba(20, 8, 44, 0.9);
    border-radius: 25px;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0;
}

.question-panel {
    position: absolute;
    top: 62px;
    left: 3%;
    right: 3%;
    height: 200px;
    flex-direction: row;
    align-items: center;
    padding: 14px 36px;
    overflow: hidden;
    background-image: url("../../Sprites/UI/Generated/question_panel_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.question-number-badge {
    width: 92px;
    height: 92px;
    min-width: 92px;
    margin-right: 14px;
    background-image: url("../../Sprites/UI/Generated/question_number_badge.png");
    -unity-background-scale-mode: scale-to-fit;
    color: rgb(16, 5, 38);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.question-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    overflow: hidden;
    color: rgb(16, 5, 38);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 0;
}

.instruction-label {
    position: absolute;
    top: 234px;
    left: 24px;
    width: 260px;
    height: 64px;
    padding: 6px 16px;
    background-color: rgb(202, 248, 60);
    border-radius: 4px;
    border-width: 4px;
    border-color: rgb(20, 8, 44);
    color: rgb(20, 8, 44);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    rotate: -6deg;
}

.answer-cells {
    position: absolute;
    top: 290px;
    left: 0;
    right: 0;
    height: 100px;
    flex-direction: row;
    justify-content: center;
}

.answer-cell {
    width: 90px;
    height: 90px;
    margin: 5px 10px;
    background-image: url("../../Sprites/UI/Generated/answer_slot_frame_neon.png");
    -unity-background-scale-mode: scale-to-fit;
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.answer-cell--c0 { -unity-background-image-tint-color: rgb(240, 64, 255); }
.answer-cell--c1 { -unity-background-image-tint-color: rgb(44, 220, 255); }
.answer-cell--c2 { -unity-background-image-tint-color: rgb(190, 255, 0); }
.answer-cell--c3 { -unity-background-image-tint-color: rgb(255, 70, 190); }

.answer-cell--filled {
    color: rgb(255, 255, 255);
}

.answer-cell--cursor {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.hiragana-buttons {
    position: absolute;
    top: 400px;
    left: 4%;
    width: 92%;
    height: 200px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.hiragana-key-row {
    height: 64px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.hiragana-key-row--wide {
    display: none;
    height: 64px;
}

.hiragana-button {
    width: 130px;
    height: 56px;
    margin: 3px 8px;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: scale, opacity;
    transition-duration: 0.08s;
}

.hiragana-button:hover { scale: 1.05 1.05; }
.hiragana-button:active { scale: 0.94 0.94; }

.hiragana-button:disabled { opacity: 0.35; }
.hiragana-button.is-used   { opacity: 0.30; }

.hiragana-button--c0,
.hiragana-button--c5 { background-image: url("../../Sprites/UI/Generated/key_button_purple.png"); }
.hiragana-button--c1,
.hiragana-button--c6 { background-image: url("../../Sprites/UI/Generated/key_button_blue.png"); }
.hiragana-button--c2,
.hiragana-button--c7 { background-image: url("../../Sprites/UI/Generated/key_button_red.png"); }
.hiragana-button--c3 { background-image: url("../../Sprites/UI/Generated/key_button_blue.png"); }
.hiragana-button--c4 { background-image: url("../../Sprites/UI/Generated/key_button_green.png"); }
.hiragana-button--c8 { background-image: url("../../Sprites/UI/Generated/key_button_orange.png"); }
.hiragana-button--c9 { background-image: url("../../Sprites/UI/Generated/key_button_wide_purple.png"); }

.hiragana-button--wide {
    width: 360px;
    height: 58px;
    background-image: url("../../Sprites/UI/Generated/key_button_wide_purple.png");
}

.hiragana-number-badge {
    position: absolute;
    top: 8px;
    left: 12px;
    width: 30px;
    height: 30px;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(12, 4, 36, 0.58);
    border-color: rgb(255, 255, 255);
    border-width: 2px;
    border-radius: 3px;
    rotate: 45deg;
    -unity-text-align: middle-center;
    padding: 0;
}

.countdown-widget {
    position: absolute;
    top: 228px;
    right: 4%;
    width: 170px;
    height: 170px;
    align-items: center;
    justify-content: center;
}

.countdown-ring-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../../Sprites/UI/Generated/countdown_ring_frame.png");
    -unity-background-scale-mode: scale-to-fit;
}

.buildup-countdown {
    width: 115px;
    height: 115px;
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ビート進捗ドット — countdown-widget 内下部に表示 */
.buildup-dots {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    height: 14px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.beat-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.22);
    margin: 0 2px;
}

.beat-dot--filled {
    background-color: rgb(202, 248, 60);
}

.answer-now-callout {
    position: absolute;
    top: 400px;
    right: 4%;
    width: 220px;
    height: 80px;
    padding: 14px 12px 6px 12px;
    background-image: url("../../Sprites/UI/Generated/answer_now_burst_frame.png");
    -unity-background-scale-mode: scale-to-fit;
    color: rgb(16, 5, 38);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 消す（backspace）ボタン — AnswerWindow 中に有効、それ以外は無効表示 */
.control-buttons {
    position: absolute;
    top: 410px;
    left: 24px;
    display: flex;
    flex-direction: column;
}

.control-button {
    padding: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 3px;
    transition-property: scale, opacity;
    transition-duration: 0.08s;
}

.backspace-button {
    width: 110px;
    height: 70px;
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgba(40, 10, 80, 0.88);
    border-radius: 14px;
    border-color: rgb(160, 80, 255);
}

.backspace-button:hover  { scale: 1.05 1.05; }
.backspace-button:active { scale: 0.94 0.94; }
.backspace-button:disabled { opacity: 0.35; }

.confirm-button { display: none; }

.characters-strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -18px;
    height: 158px;
    padding: 0;
}

.character-slot {
    position: absolute;
    bottom: 0;
    height: 100%;
    width: 112px;
    background-size: contain;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
}

.character-slot--v0 { left: 4%; rotate: -4deg; width: 142px; }
.character-slot--v1 { left: 22%; rotate: 5deg; width: 74px; opacity: 0.82; }
.character-slot--v2 { right: 24%; rotate: -1deg; width: 74px; opacity: 0.82; }
.character-slot--v3 { right: 17%; rotate: 4deg; width: 76px; opacity: 0.82; }
.character-slot--v4 { right: 4%; rotate: -3deg; width: 142px; }

.cameo-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.cameo-slot {
    position: absolute;
    width: 58px;
    height: 66px;
    background-size: contain;
    background-repeat: no-repeat;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.75;
}

/* 左右の端に散らして配置 — ボタン・回答セル・メインキャラと重ならない縦帯に収める */
.cameo-slot--v0 { left: 320;   bottom: 158px;  rotate: -7deg; }
.cameo-slot--v1 { left: 35;   bottom: 168px; rotate:  3deg; }
.cameo-slot--v2 { left: 220;   bottom: 270px; rotate: -2deg; }
.cameo-slot--v3 { right: 10;  bottom: 140px;  rotate:  6deg; }
.cameo-slot--v4 { right: 330;  bottom: 300px; rotate: -5deg; }

.blue-overlay,
.flash-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.blue-overlay   { background-color: rgba(0, 80, 255, 0); }
.flash-overlay  { background-color: rgba(255, 255, 220, 0); }
.fade-overlay   { background-color: rgb(0, 0, 0); opacity: 0; }

.correct-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 34%;
    width: 100%;
    height: 150px;
    -unity-text-align: middle-center;
    font-size: 88px;
    color: rgb(255, 230, 0);
    -unity-font-style: bold;
    scale: 0 0;
}

.incorrect-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    width: 100%;
    height: 130px;
    -unity-text-align: middle-center;
    font-size: 76px;
    color: rgb(180, 220, 255);
    -unity-font-style: bold;
    scale: 0 0;
}

.result-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 13, 26, 0.95);
}

.result-title {
    font-size: 28px;
    color: rgb(170, 170, 204);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.score-label {
    font-size: 80px;
    color: rgb(255, 230, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.score-unit {
    font-size: 32px;
    color: rgb(255, 230, 0);
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.rank-label {
    font-size: 100px;
    color: rgb(255, 60, 142);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    scale: 0 0;
}

.rank-text-label {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 32px;
}

.retry-button {
    min-width: 240px;
    height: 72px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(13, 13, 26);
    background-color: rgb(0, 240, 255);
    border-color: rgb(0, 240, 255);
    border-radius: 20px;
    border-width: 0;
}
