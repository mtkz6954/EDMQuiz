/* ======================================================
   common.uss  —  EDMQuiz 共通スタイル
   カラーパレット: ネオン × 紫スポットライト × EDMフロア
====================================================== */

/* ─── 変数定義 (UI Toolkit は CSS カスタムプロパティ非対応のため定数コメントで管理) ───
   --bg-deep        : #14082c
   --bg-mid         : #2a1252
   --bg-purple      : #5a2090
   --neon-pink      : #ff3c8e
   --neon-magenta   : #ff60c0
   --neon-cyan      : #00f0ff
   --neon-yellow    : #ffe600
   --neon-green     : #6ed848
   --neon-orange    : #ff8c20
   --neon-violet    : #a060ff
   --text-white     : #ffffff
   --text-dim       : #aaaacc
   --dark-text      : #1e1e32
─────────────────────────────────────────────────────── */

/* ─── Root: ライブハウス風の紫グラデ + フロア ─── */
.background-panel {
    -unity-font-definition: url("../../ReggaeOne-Regular.ttf");
    flex-grow: 1;
    /* 暗紫 wash でベース画面を暗化 → 世界空間の Light2D スポットライト演出が
       コントラストでクッキリ浮かぶ。完全透明にすると EDM ステージ画像が明るすぎて
       スポットライトの色が埋もれる。 */
    background-color: rgba(20, 4, 48, 0.35);
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    overflow: hidden;
}

/* 中央上のスポットライト光（ぼかしは無いが紫の柔らかい点光源） */
.bg-spotlight {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin-left: 0;
    background-color: rgba(92, 0, 132, 0.64);
    border-radius: 0;
}

/* 床のグラデ（下半分を少し赤紫に） */
.bg-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 28%;
    background-color: rgba(142, 35, 128, 0.42);
}

/* 星屑（小さな白点を散布） */
.bg-star {
    position: absolute;
    width: 3px;
    height: 3px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 2px;
}
.bg-star--s1 { top: 12%; left: 8%;  width: 2px; height: 2px; opacity: 0.7; }
.bg-star--s2 { top: 18%; left: 22%; width: 4px; height: 4px; opacity: 0.9; }
.bg-star--s3 { top: 9%;  left: 38%; width: 2px; height: 2px; opacity: 0.6; }
.bg-star--s4 { top: 22%; left: 60%; width: 3px; height: 3px; opacity: 0.85; }
.bg-star--s5 { top: 14%; left: 78%; width: 2px; height: 2px; opacity: 0.65; }
.bg-star--s6 { top: 30%; left: 90%; width: 3px; height: 3px; opacity: 0.7; }
.bg-star--s7 { top: 42%; left: 4%;  width: 2px; height: 2px; opacity: 0.5; }
.bg-star--s8 { top: 8%;  left: 92%; width: 4px; height: 4px; opacity: 0.85; }
.bg-star--s9 { top: 50%; left: 95%; width: 2px; height: 2px; opacity: 0.45; }
.bg-star--s10{ top: 35%; left: 50%; width: 2px; height: 2px; opacity: 0.55; }

/* ─── オーバーレイ ─── */
.blue-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 80, 255, 0);
}

/* ─── 正解時の白フラッシュ ─── */
.flash-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 220, 0);
}

/* ─── 正解ラベル ─── */
.correct-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 34%;
    width: 100%;
    height: 150px;
    -unity-text-align: middle-center;
    font-size: 88px;
    color: rgb(255, 230, 0);
    -unity-font-style: bold;
    text-shadow: 4px 4px 0 rgb(255, 60, 142);
    scale: 0 0;
}

/* ─── 不正解ラベル（青ざめ系） ─── */
.incorrect-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 36%;
    width: 100%;
    height: 130px;
    -unity-text-align: middle-center;
    font-size: 76px;
    color: rgb(180, 220, 255);
    -unity-font-style: bold;
    text-shadow: 4px 4px 0 rgb(20, 40, 110);
    scale: 0 0;
}

/* ─── 進捗カウンター (左上 "Q3/5") ─── */
.progress-counter {
    position: absolute;
    top: 18px;
    left: 74px;
    background-color: rgba(20, 8, 44, 0.92);
    border-radius: 26px;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    width: 138px;
    height: 58px;
    padding: 6px 16px;
    font-size: 29px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
}

/* ─── 問題パネル ─── */
.question-panel {
    position: absolute;
    top: 76px;
    left: 3%;
    right: 3%;
    height: 156px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 16px 64px;
    margin-top: 0;
    margin-bottom: 0;
    max-width: 100%;
    min-width: 0;
    border-width: 8px;
    border-color: rgb(20, 8, 44);
}

.question-number-badge {
    width: 92px;
    height: 92px;
    min-width: 92px;
    background-color: rgb(255, 230, 0);
    border-radius: 12px;
    border-width: 6px;
    border-color: rgb(20, 8, 44);
    font-size: 46px;
    color: rgb(20, 8, 44);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 28px;
}

/* 問題文（コミック調）。リッチテキストで強調語を <color=#ff3c8e> で囲む想定 */
.question-text {
    font-size: 40px;
    color: rgb(20, 8, 44);
    -unity-text-align: middle-left;
    white-space: normal;
    flex-grow: 1;
    -unity-font-style: bold;
    letter-spacing: 0;
    text-shadow: 3px 4px 0 rgba(255, 0, 200, 0.28);
}

/* ─── 指示ラベル（黄緑テープ風・斜め貼り） ─── */
.instruction-label {
    position: absolute;
    top: 194px;
    left: 70px;
    width: 310px;
    height: 64px;
    background-color: rgb(202, 248, 60);
    color: rgb(20, 8, 44);
    font-size: 31px;
    -unity-font-style: bold;
    border-radius: 4px;
    padding: 7px 18px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    rotate: -6deg;
    -unity-text-align: middle-center;
    align-self: flex-start;
    border-width: 4px;
    border-color: rgb(20, 8, 44);
}

/* ─── 回答セル行 ─── */
.answer-cells {
    position: absolute;
    top: 252px;
    left: 0;
    right: 0;
    height: 140px;
    flex-direction: row;
    justify-content: center;
    margin-bottom: 0;
}

.answer-cell {
    width: 126px;
    height: 126px;
    border-width: 6px;
    border-color: rgb(20, 8, 44);
    border-radius: 16px;
    margin: 12px;
    font-size: 78px;
    color: rgb(20, 8, 44);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.0);
}

/* セルごとの色バリエ（埋まっていない初期状態でも配色を保つ） */
.answer-cell--c0 { background-color: rgb(255, 230, 0); }
.answer-cell--c1 { background-color: rgb(0, 220, 255); }
.answer-cell--c2 { background-color: rgb(190, 255, 0); }
.answer-cell--c3 { background-color: rgb(255, 255, 255); }

/* 入力済セル: わずかな傾きで動きを出す */
.answer-cell--filled {
    rotate: -3deg;
}
.answer-cell--filled.answer-cell--c1 { rotate: 4deg; }
.answer-cell--filled.answer-cell--c2 { rotate: -2deg; }
.answer-cell--filled.answer-cell--c3 { rotate: 3deg; }

/* カーソル位置セル: 白点線風（実線太枠で代用） */
.answer-cell--cursor {
    background-color: rgba(22, 10, 52, 0.34);
    border-color: rgb(255, 255, 255);
    border-width: 6px;
    color: rgb(255, 255, 255);
}

/* ─── ひらがなボタン群 ─── */
.hiragana-buttons {
    position: absolute;
    top: 382px;
    left: 0;
    right: 0;
    height: 124px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 100%;
    margin-bottom: 0;
}

.hiragana-button {
    width: 108px;
    height: 108px;
    margin: 10px;
    font-size: 67px;
    color: rgb(20, 8, 44);
    background-color: rgb(255, 255, 255);
    border-color: rgb(20, 8, 44);
    border-width: 6px;
    border-radius: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, scale, rotate;
    transition-duration: 0.12s;
}

/* 色バリエ */
.hiragana-button--c0 { background-color: rgb(255, 230, 0); rotate: -3deg; }
.hiragana-button--c1 { background-color: rgb(0, 220, 255); rotate: 2deg; }
.hiragana-button--c2 { background-color: rgb(190, 255, 0); rotate: -2deg; }
.hiragana-button--c3 { background-color: rgb(255, 255, 255); rotate: 3deg; }
.hiragana-button--c4 { background-color: rgb(255, 140, 32); color: rgb(255, 255, 255); rotate: -4deg; }
.hiragana-button--c5 { background-color: rgb(255, 60, 180); color: rgb(255, 255, 255); rotate: 4deg; }
.hiragana-button--c6 { background-color: rgb(160, 96, 255); color: rgb(255, 255, 255); rotate: -3deg; }

.hiragana-button:hover {
    scale: 1.06 1.06;
}

.hiragana-button:active {
    scale: 0.94 0.94;
}

/* 使用済（disabled / .is-used）は色を保持しつつ暗く落とす */
.hiragana-button:disabled,
.hiragana-button.is-used {
    opacity: 0.45;
}

/* 使用済を更にグレーアウト（モックアップの暗灰色と一致） */
.hiragana-button.is-used {
    background-color: rgb(70, 70, 90);
    color: rgba(255, 255, 255, 0.35);
    border-color: rgb(40, 40, 60);
    opacity: 0.7;
}

/* キーボードショートカット番号バッジ（左上に小さく重ねる） */
.hiragana-number-badge {
    position: absolute;
    top: 4px;
    left: 6px;
    width: 28px;
    height: 28px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(20, 8, 44);
    background-color: rgba(255, 255, 255, 0.92);
    border-color: rgba(20, 8, 44, 0.9);
    border-width: 2px;
    border-radius: 12px;
    -unity-text-align: middle-center;
    padding: 0;
}

/* ─── コントロールボタン行（モックアップに無いので非表示） ─── */
.control-buttons {
    display: none;
}
